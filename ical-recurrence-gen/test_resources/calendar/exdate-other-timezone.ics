BEGIN:VCALENDAR
PRODID:Example
VERSION:2.0
BEGIN:VTIMEZONE
TZID:PlusOne
BEGIN:STANDARD
DTSTART:19700101T000000
TZOFFSETFROM:+0100
TZOFFSETTO:+0100
END:STANDARD
END:VTIMEZONE
BEGIN:VTIMEZONE
TZID:PlusTwo
BEGIN:STANDARD
DTSTART:19700101T000000
TZOFFSETFROM:+0200
TZOFFSETTO:+0200
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
DTSTAMP:19960704T120000Z
UID:0
DTSTART;TZID=PlusOne:20200101T010000
DTEND;TZID=PlusOne:20200101T020000
SUMMARY:An EXDATE given in a different time zone than DTSTART
DESCRIPTION:02:00 at +0200 is the same instant as the second instance\, which
  is at 01:00 at +0100.
RRULE:FREQ=DAILY;COUNT=3
EXDATE;TZID=PlusTwo:20200102T020000
END:VEVENT
END:VCALENDAR
