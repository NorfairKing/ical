PRODID:Example
VERSION:2.0
BEGIN:VTIMEZONE
TZID:Europe/Zurich
BEGIN:DAYLIGHT
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
TZNAME:CEST
DTSTART:19700329T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
TZNAME:CET
DTSTART:19701025T030000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
DTSTAMP:19960704T120000Z
UID:0
DTSTART;TZID=Europe/Zurich:20220325T023000
DTEND;TZID=Europe/Zurich:20220325T033000
SUMMARY:An instance that falls in a daylight saving time gap
DESCRIPTION:On the 27th of March 2022 the local time jumps from 02:00 to
  03:00\, so 02:30 does not exist that day.  Like an invalid date it is
  ignored and does not use up one of the four counted instances.
RRULE:FREQ=DAILY;COUNT=4
END:VEVENT
END:VCALENDAR
